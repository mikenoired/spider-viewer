{
	"name": "spider-viewer",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"prepare:ocr-assets": "node ./scripts/prepare-ocr-assets.mjs",
		"dev": "bun run prepare:ocr-assets && vite dev --port 3000",
		"build": "bun run prepare:ocr-assets && vite build",
		"start": "bun ./scripts/serve.mjs",
		"start:prod": "NODE_ENV=production bun ./scripts/serve.mjs",
		"start:railway": "NODE_ENV=production HOST=0.0.0.0 bun ./scripts/serve.mjs",
		"preview": "vite preview",
		"predeploy": "bun ./scripts/predeploy.mjs",
		"test": "vitest run",
		"db:generate": "bunx --bun drizzle-kit generate",
		"db:migrate": "bunx --bun drizzle-kit migrate",
		"db:push": "bunx --bun drizzle-kit push",
		"db:deploy": "drizzle-kit push",
		"db:studio": "bunx --bun drizzle-kit studio",
		"auth:seed:superusers": "bun seed-superusers.mjs",
		"lint": "oxlint .",
		"typecheck": "bun x tsc -p tsconfig.json --noEmit",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint:format": "bun run format",
		"lint:check": "bun run lint && bun run format:check"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.60",
		"@tanstack/react-table": "^9.2.6",
		"@tanstack/router-plugin": "^1.168.42",
		"@tesseract.js-data/eng": "^1.0.0",
		"@tesseract.js-data/rus": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"docx": "^9.9.0",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.12",
		"lucide-react": "^1.53.0",
		"motion": "^14.0.0",
		"next-themes": "^0.4.6",
		"pino": "^10.4.0",
		"postgres": "^3.4.9",
		"react": "^19.3.0",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.3.0",
		"redis": "^6.3.0",
		"shadcn": "^4.21.4",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tesseract.js": "^7.0.0",
		"tesseract.js-core": "^6.1.2",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"xlsx": "^0.18.5",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "^0.8.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^30.1.2",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"radix-ui": "^1.7.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.11"
	}
}
