{
	"name": "spider-viewer",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "bun ./scripts/serve.mjs",
		"start:prod": "NODE_ENV=production bun ./scripts/serve.mjs",
		"start:railway": "NODE_ENV=production HOST=0.0.0.0 bun ./scripts/serve.mjs",
		"preview": "vite preview",
		"predeploy": "bun ./scripts/predeploy.mjs",
		"test": "vitest run",
		"db:generate": "bunx --bun drizzle-kit generate",
		"db:migrate": "bunx --bun drizzle-kit migrate",
		"db:push": "bunx --bun drizzle-kit push",
		"db:deploy": "drizzle-kit push",
		"db:studio": "bunx --bun drizzle-kit studio",
		"auth:seed:superusers": "bun seed-superusers.mjs",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint:format": "bun run format",
		"lint:check": "bun run lint && bun run format:check"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-devtools": "^0.10.9",
		"@tanstack/react-form": "^1.33.2",
		"@tanstack/react-router": "^1.170.18",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.33",
		"@tanstack/react-table": "^8.21.3",
		"@tanstack/router-plugin": "^1.168.23",
		"@tesseract.js-data/eng": "^1.0.0",
		"@tesseract.js-data/rus": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"docx": "^9.7.1",
		"drizzle-orm": "^0.45.2",
		"jose": "^6.2.5",
		"lucide-react": "^1.28.0",
		"motion": "^12.43.0",
		"next-themes": "^0.4.6",
		"pino": "^10.3.1",
		"postgres": "^3.4.9",
		"react": "^19.2.8",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"redis": "^6.1.0",
		"shadcn": "^4.16.0",
		"sharp": "^0.35.4",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tesseract.js": "^7.0.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2",
		"xlsx": "^0.18.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@tanstack/devtools-vite": "^0.8.3",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.5",
		"@types/sax": "^1.2.7",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"oxfmt": "0.42.0",
		"oxlint": "1.76.0",
		"radix-ui": "^1.6.7",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	},
	"packageManager": "bun@1.3.11"
}
