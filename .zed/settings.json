{
	"lsp": {
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"run": "onType",
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"unusedDisableDirectives": "deny"
				}
			}
		}
	},
	"languages": {
		"CSS": {
			"format_on_save": "on",
			"prettier": {
				"allowed": false
			},
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"HTML": {
